{
  // Một Worker phục vụ cả web app Flutter lẫn API upload ảnh (cùng domain, không lo CORS).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "unihub-beta",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "../mobile/build/web",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/images/*", "/videos/*"]
  },
  // Tạo bằng: npx wrangler kv namespace create STORE (id của tài khoản đang deploy).
  "kv_namespaces": [
    { "binding": "STORE", "id": "fb145a5f4275426ebfbe8057d164ffd1" }
  ]
}
