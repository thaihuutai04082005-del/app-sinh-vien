rules_version = '2';

// Ai cũng đọc được. Muốn đăng phải có tài khoản (app tự đăng nhập ẩn danh),
// mỗi tài khoản tối đa 10 tin và 30 ảnh/video mỗi ngày (đếm trong quota/{uid}).
// Hồ sơ người dùng nằm ở users/{uid}. Không ai sửa/xóa tin qua app. Số liệu khớp mobile/lib/core/services/daily_quota.dart.
service cloud.firestore {
  match /databases/{database}/documents {
    function today() {
      return int(math.floor(request.time.toMillis() / 86400000));
    }

    function quotaPath() {
      return /databases/$(database)/documents/quota/$(request.auth.uid);
    }

    function postsBefore() {
      return exists(quotaPath()) && get(quotaPath()).data.day == today()
        ? get(quotaPath()).data.posts : 0;
    }

    // Tin mới phải đi kèm lượt tăng bộ đếm trong cùng transaction, và id tin
    // gắn với số thứ tự đó nên 1 lượt đếm chỉ tạo được đúng 1 tin.
    function isCountedPost(id, ownerField) {
      let posts = getAfter(quotaPath()).data.posts;
      return request.auth != null
        && request.resource.data[ownerField] == request.auth.uid
        && posts == postsBefore() + 1
        && id == request.auth.uid + '_' + string(today()) + '_' + string(posts)
        && request.resource.data.createdAt == request.time;
    }

    // Link ảnh do người dùng dán: https, không khoảng trắng, tối đa 2000 ký tự.
    function isHttpsUrl(u) {
      return u is string && u.size() <= 2000 && u.matches('^https://[^ ]+$');
    }

    // Kiểm tra từng link (danh sách tối đa 6 phần tử; giới hạn số lượng do isUrlList).
    function allHttpsUrls(l) {
      return (l.size() < 1 || isHttpsUrl(l[0]))
        && (l.size() < 2 || isHttpsUrl(l[1]))
        && (l.size() < 3 || isHttpsUrl(l[2]))
        && (l.size() < 4 || isHttpsUrl(l[3]))
        && (l.size() < 5 || isHttpsUrl(l[4]))
        && (l.size() < 6 || isHttpsUrl(l[5]));
    }

    function isUrlList(value, max) {
      return value is list && value.size() <= max;
    }

    match /quota/{uid} {
      function before(field) {
        return resource == null || resource.data.day != today() ? 0 : resource.data[field];
      }

      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['day', 'posts', 'uploads'])
        && request.resource.data.day == today()
        && ((request.resource.data.posts == before('posts') + 1
             && request.resource.data.posts <= 10
             && request.resource.data.uploads == before('uploads'))
          || (request.resource.data.uploads == before('uploads') + 1
             && request.resource.data.uploads <= 30
             && request.resource.data.posts == before('posts')));
    }

    match /products/{id} {
      allow read: if true;
      allow create: if isCountedPost(id, 'shopId')
        && request.resource.data.keys().hasOnly(['shopId', 'name', 'images', 'price', 'sizes',
                                                 'stock', 'category', 'status', 'videos', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 200
        && request.resource.data.price is number
        && request.resource.data.price >= 0
        && request.resource.data.stock is int
        && request.resource.data.status == 'active'
        && isUrlList(request.resource.data.images, 10)
        && request.resource.data.images.size() > 0
        && isUrlList(request.resource.data.videos, 1);
      allow update, delete: if false;
    }

    match /booking_xe/{id} {
      allow read: if true;
      allow create: if isCountedPost(id, 'userId')
        && request.resource.data.keys().hasOnly(['userId', 'driverId', 'fromAddress', 'toAddress',
                                                 'itemPhotos', 'quotedPrice', 'scheduledAt', 'status',
                                                 'videos', 'createdAt'])
        && request.resource.data.fromAddress is string
        && request.resource.data.fromAddress.size() > 0
        && request.resource.data.toAddress is string
        && request.resource.data.toAddress.size() > 0
        && request.resource.data.scheduledAt is timestamp
        && request.resource.data.quotedPrice == null
        && request.resource.data.status == 'pending'
        && isUrlList(request.resource.data.itemPhotos, 10)
        && isUrlList(request.resource.data.videos, 1);
      allow update, delete: if false;
    }

    // Hồ sơ người dùng: chỉ chính chủ đọc/ghi, và phải là tài khoản email (không phải ẩn danh).
    // Không cho tự đổi role/email/uid; chỉ sửa được name và phone.
    match /users/{uid} {
      function isOwner() {
        return request.auth != null && request.auth.uid == uid
          && request.auth.token.firebase.sign_in_provider != 'anonymous';
      }

      function validContact() {
        return request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 100
          && request.resource.data.phone is string
          && request.resource.data.phone.size() <= 15;
      }

      allow read: if isOwner();
      allow create: if isOwner()
        && request.resource.data.keys().hasOnly(['uid', 'name', 'email', 'phone', 'avatarUrl',
                                                 'role', 'schoolEmail', 'createdAt'])
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == 'student'
        && request.resource.data.createdAt == request.time
        && validContact();
      allow update: if isOwner()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'phone'])
        && validContact();
      allow delete: if false;
    }

    // ================================================================ TÀI KHOẢN (Phần 4)
    function signedIn() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function adminDoc() {
      return /databases/$(database)/documents/admins/$(request.auth.uid);
    }

    function laAdmin(quyen) {
      return signedIn() && exists(adminDoc()) && get(adminDoc()).data.get(quyen, false) == true;
    }

    function xacThucCuaToi() {
      return get(/databases/$(database)/documents/xac_thuc/$(request.auth.uid)).data;
    }

    // Số điện thoại đã OTP của người đang gọi (null nếu chưa có).
    function sdtCuaToi() {
      return exists(/databases/$(database)/documents/xac_thuc/$(request.auth.uid))
          && xacThucCuaToi().get('sdtDaXacThuc', false) == true
        ? xacThucCuaToi().get('sdt', null) : null;
    }

    // Trạng thái xác thực: chỉ Cloud Functions ghi. Admin danh tính đọc hàng chờ duyệt.
    match /xac_thuc/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || laAdmin('danhTinh');
      allow write: if false;
    }

    // Quyền admin: tạo trong Firebase Console; người dùng chỉ đọc quyền của chính mình.
    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // ================================================================ MODULE TÌM TRỌ
    // Hệ thống quyết định (mục 2.18): mọi chuyển trạng thái, tiền, chat, đánh giá, báo cáo đi qua
    // Cloud Functions. App chỉ tự ghi: bản nháp nhà trọ / phòng của mình, lưu ❤️, cài đặt thông báo,
    // đánh dấu đã đọc thông báo.

    function chiDoiCacTruong(truong) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(truong);
    }

    function truongNhapNhaTro() {
      return ['chuTroId', 'ten', 'loaiHinh', 'tongSoPhong', 'soTang', 'tienIchChung', 'noiQuy', 'moTa',
              'diaChi', 'phuong', 'searchText', 'viTri', 'anh', 'video', 'anhBia', 'camKet',
              'trangThai', 'taoLuc', 'capNhatLuc'];
    }

    function truongNhapPhong() {
      return ['nhaTroId', 'chuTroId', 'ten', 'khu', 'tang', 'coGac', 'dienTich', 'dienTichGac', 'soNguoiToiDa',
              'soPhongNgu', 'soWc', 'coBep', 'tienIch', 'giaThue', 'tienCoc', 'tienDien', 'tienNuoc', 'phiKhac',
              'hopDongToiThieu', 'ngayVaoO', 'moTa', 'anh', 'video', 'anhBia', 'trangThai', 'daXoa',
              'taoLuc', 'capNhatLuc'];
    }

    function laChu(data) {
      return signedIn() && data.chuTroId == request.auth.uid;
    }

    // Nhà trọ: ai cũng xem tin đang hiển thị; chủ xem tin của mình; admin Tìm trọ xem tất cả.
    match /nha_tro/{id} {
      allow read: if resource.data.trangThai == 'active' || laChu(resource.data) || laAdmin('tro');
      allow create: if laChu(request.resource.data)
        && request.resource.data.trangThai == 'draft'
        && request.resource.data.keys().hasOnly(truongNhapNhaTro());
      allow update: if laChu(resource.data) && laChu(request.resource.data)
        && resource.data.trangThai in ['draft', 'rejected']
        && request.resource.data.trangThai == 'draft'
        && chiDoiCacTruong(truongNhapNhaTro());
      allow delete: if laChu(resource.data) && resource.data.trangThai == 'draft';

      // Giấy tờ nhà: riêng tư, chỉ chủ trọ và admin Tìm trọ.
      match /rieng/{docId} {
        function nha() {
          return get(/databases/$(database)/documents/nha_tro/$(id)).data;
        }
        allow read: if laChu(nha()) || laAdmin('tro');
        allow write: if laChu(nha()) && nha().trangThai in ['draft', 'rejected']
          && request.resource.data.keys().hasOnly(['giayTo'])
          && request.resource.data.giayTo is list && request.resource.data.giayTo.size() <= 4;
      }
    }

    // Phòng: ai cũng xem phòng còn trống / đã cọc / đã cho thuê; bản nháp, tạm ẩn, chờ duyệt chỉ chủ và admin.
    match /phong_tro/{id} {
      allow read: if (resource.data.trangThai in ['available', 'reserved', 'rented'] && resource.data.get('daXoa', false) == false)
        || laChu(resource.data) || laAdmin('tro');
      allow create: if laChu(request.resource.data)
        && request.resource.data.trangThai == 'draft'
        && request.resource.data.daXoa == false
        && request.resource.data.keys().hasOnly(truongNhapPhong())
        && get(/databases/$(database)/documents/nha_tro/$(request.resource.data.nhaTroId)).data.chuTroId == request.auth.uid;
      allow update: if laChu(resource.data) && laChu(request.resource.data)
        && resource.data.trangThai in ['draft', 'rejected']
        && request.resource.data.trangThai == 'draft'
        && request.resource.data.nhaTroId == resource.data.nhaTroId
        && chiDoiCacTruong(truongNhapPhong());
      allow delete: if laChu(resource.data) && resource.data.trangThai in ['draft', 'rejected'];
    }

    // Khoản cọc, khoản tiền: chỉ sinh viên, chủ trọ của giao dịch và admin Tìm trọ đọc. Không ai ghi qua app.
    match /tro_dat_coc/{id} {
      allow read: if signedIn() && (resource.data.sinhVienId == request.auth.uid
        || resource.data.chuTroId == request.auth.uid || laAdmin('tro'));
      allow write: if false;
    }

    match /tro_khoan_tien/{id} {
      allow read: if signedIn() && (resource == null || resource.data.nguoiTra == request.auth.uid
        || resource.data.nguoiNhan == request.auth.uid || laAdmin('tro'));
      allow write: if false;
    }

    // Ví chủ trọ (chỉ hiển thị).
    match /tro_vi/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // Cọc trực tiếp: chủ trọ, người cọc (đúng số điện thoại đã OTP mà chủ nhập) và admin.
    match /tro_coc_truc_tiep/{id} {
      allow read: if signedIn() && (resource == null || resource.data.chuTroId == request.auth.uid
        || (resource.data.sdtNguoiCoc != null && resource.data.sdtNguoiCoc == sdtCuaToi()) || laAdmin('tro'));
      allow write: if false;
    }

    // Vi phạm, khóa chức năng: người bị ghi xem của mình; admin xem tất cả.
    match /tro_vi_pham/{id} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || laAdmin('tro'));
      allow write: if false;
    }

    match /tro_khoa/{khoa} {
      allow read: if signedIn() && (khoa == request.auth.uid || khoa == sdtCuaToi() || laAdmin('tro'));
      allow write: if false;
    }

    // Chỉ số uy tín công khai của chủ trọ.
    match /tro_chi_so_chu/{uid} {
      allow read: if true;
      allow write: if false;
    }

    // Hồ sơ riêng trong module: người dùng chỉ tự sửa cài đặt thông báo (bật / tắt từng nhóm).
    match /tro_ho_so/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['caiDatThongBao'])
        && request.resource.data.caiDatThongBao is map;
      allow update: if signedIn() && request.auth.uid == uid
        && chiDoiCacTruong(['caiDatThongBao'])
        && request.resource.data.caiDatThongBao is map;
      allow delete: if false;
    }

    // Lưu ❤️ nhà trọ (không lưu được nhà trọ của chính mình).
    match /tro_luu/{id} {
      allow read: if signedIn() && (resource == null || resource.data.uid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && id == request.auth.uid + '_' + request.resource.data.nhaTroId
        && request.resource.data.keys().hasOnly(['uid', 'nhaTroId', 'nhanThongBao', 'luc'])
        && request.resource.data.nhanThongBao is bool
        && get(/databases/$(database)/documents/nha_tro/$(request.resource.data.nhaTroId)).data.chuTroId != request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    // Chat riêng của Tìm trọ: chỉ 2 người trong cuộc (và admin khi xử lý khiếu nại). Gửi tin qua hệ thống.
    match /tro_chat/{chatId} {
      allow read: if signedIn() && (resource == null || request.auth.uid in resource.data.thanhVien || laAdmin('tro'));
      allow write: if false;

      match /tin_nhan/{tinId} {
        allow read: if signedIn() && (request.auth.uid in get(/databases/$(database)/documents/tro_chat/$(chatId)).data.thanhVien
          || laAdmin('tro'));
        allow write: if false;
      }
    }

    // Đánh giá: hiện công khai (trừ bị ẩn); người viết xem đánh giá của mình. Viết / sửa qua hệ thống.
    match /tro_danh_gia/{id} {
      allow read: if resource == null || resource.data.hienThi == 'hien'
        || (signedIn() && resource.data.nguoiViet == request.auth.uid) || laAdmin('tro');
      allow write: if false;
    }

    match /tro_bao_cao/{id} {
      allow read: if laAdmin('tro');
      allow write: if false;
    }

    match /tro_khang_nghi/{id} {
      allow read: if signedIn() && (resource.data.nguoiGui == request.auth.uid || laAdmin('tro'));
      allow write: if false;
    }

    // Thông báo: người nhận đọc và chỉ được đánh dấu đã đọc.
    match /tro_thong_bao/{id} {
      allow read: if signedIn() && resource.data.nguoiNhan == request.auth.uid;
      allow update: if signedIn() && resource.data.nguoiNhan == request.auth.uid
        && chiDoiCacTruong(['docLuc']);
      allow create, delete: if false;
    }

    match /tro_nhat_ky_admin/{id} {
      allow read: if laAdmin('tro');
      allow write: if false;
    }

    // =====================================================================
    // QUÁN ĂN (tiền tố qa_): chủ quán chỉ ghi BẢN NHÁP quán và lưu ❤️; mọi thứ khác do Cloud Functions ghi.
    // =====================================================================

    function truongNhapQuan() {
      return ['chuQuanId', 'ten', 'loaiQuan', 'loaiMon', 'moTa', 'sdt', 'diaChi', 'phuong', 'viTri', 'luuDong',
              'ghiChuViTri', 'gioMoCua', 'phucVu', 'tienIch', 'nhanDatBan', 'datMon', 'anhMatTien', 'anhBia',
              'anhKhac', 'viTriAnh', 'camKet', 'searchText', 'trangThai', 'taoLuc', 'capNhatLuc'];
    }

    function laChuQuan(data) {
      return signedIn() && data.chuQuanId == request.auth.uid;
    }

    // Quán: ai cũng xem quán đang hoạt động; chủ xem quán của mình; admin Quán ăn xem tất cả.
    match /qa_quan/{id} {
      allow read: if resource.data.trangThai == 'active' || laChuQuan(resource.data) || laAdmin('quanAn');
      allow create: if laChuQuan(request.resource.data)
        && request.resource.data.trangThai == 'draft'
        && request.resource.data.keys().hasOnly(truongNhapQuan());
      allow update: if laChuQuan(resource.data) && laChuQuan(request.resource.data)
        && resource.data.trangThai in ['draft', 'rejected']
        && request.resource.data.trangThai == 'draft'
        && chiDoiCacTruong(truongNhapQuan());
      allow delete: if laChuQuan(resource.data) && resource.data.trangThai == 'draft';

      // Giấy tờ (mã số thuế, giấy chứng nhận): riêng tư, chỉ chủ quán và admin Quán ăn.
      match /rieng/{docId} {
        function quanCha() {
          return get(/databases/$(database)/documents/qa_quan/$(id)).data;
        }
        allow read: if laChuQuan(quanCha()) || laAdmin('quanAn');
        allow write: if laChuQuan(quanCha()) && quanCha().trangThai in ['draft', 'rejected']
          && request.resource.data.keys().hasOnly(['maSoThue', 'anhGiayChungNhan', 'anhAttp'])
          && request.resource.data.get('anhGiayChungNhan', []).size() <= 4
          && request.resource.data.get('anhAttp', []).size() <= 4;
      }
    }

    // Menu, khuyến mãi: công khai (xem menu của quán); ghi qua hệ thống (tính lại mức giá, chữ tìm kiếm).
    match /qa_nhom_mon/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /qa_mon/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /qa_khuyen_mai/{id} {
      allow read: if true;
      allow write: if false;
    }

    // Check-in: công khai nếu người check-in chọn; người check-in luôn xem của mình.
    match /qa_check_in/{id} {
      allow read: if resource.data.congKhai == true || (signedIn() && resource.data.svId == request.auth.uid)
        || laAdmin('quanAn');
      allow write: if false;
    }

    // Đặt bàn, đơn món, khoản tiền: chỉ sinh viên, chủ quán của giao dịch và admin. Không ai ghi qua app.
    match /qa_dat_ban/{id} {
      allow read: if signedIn() && (resource.data.svId == request.auth.uid
        || resource.data.chuQuanId == request.auth.uid || laAdmin('quanAn'));
      allow write: if false;
    }

    match /qa_don/{id} {
      allow read: if signedIn() && (resource.data.svId == request.auth.uid
        || resource.data.chuQuanId == request.auth.uid || laAdmin('quanAn'));
      allow write: if false;

      // Mã nhận món 4 số: CHỈ sinh viên của đơn đọc được (chủ quán chỉ nhập mã qua hệ thống).
      match /rieng/{docId} {
        allow read: if signedIn()
          && get(/databases/$(database)/documents/qa_don/$(id)).data.svId == request.auth.uid;
        allow write: if false;
      }
    }

    match /qa_khoan_tien/{id} {
      allow read: if signedIn() && (resource == null || resource.data.nguoiTra == request.auth.uid
        || resource.data.nguoiNhan == request.auth.uid || laAdmin('quanAn'));
      allow write: if false;
    }

    match /qa_cong_gia_lap/{id} {
      allow read, write: if false;
    }

    // Ví chủ quán (chỉ hiển thị).
    match /qa_vi/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // Vi phạm, khóa chức năng: người bị ghi xem của mình; admin xem tất cả.
    match /qa_vi_pham/{id} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || laAdmin('quanAn'));
      allow write: if false;
    }

    match /qa_khieu_nai_sai/{id} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || laAdmin('quanAn'));
      allow write: if false;
    }

    match /qa_khoa/{khoa} {
      allow read: if signedIn() && (khoa == request.auth.uid || khoa == sdtCuaToi() || laAdmin('quanAn'));
      allow write: if false;
    }

    // Chỉ số uy tín công khai của chủ quán.
    match /qa_chi_so_chu/{uid} {
      allow read: if true;
      allow write: if false;
    }

    // Hồ sơ riêng trong module: người dùng chỉ tự sửa cài đặt thông báo.
    match /qa_ho_so/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['caiDatThongBao'])
        && request.resource.data.caiDatThongBao is map;
      allow update: if signedIn() && request.auth.uid == uid
        && chiDoiCacTruong(['caiDatThongBao'])
        && request.resource.data.caiDatThongBao is map;
      allow delete: if false;
    }

    // Lưu ❤️ quán (không lưu được quán của chính mình).
    match /qa_luu/{id} {
      allow read: if signedIn() && (resource == null || resource.data.uid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && id == request.auth.uid + '_' + request.resource.data.quanId
        && request.resource.data.keys().hasOnly(['uid', 'quanId', 'nhanThongBao', 'luc'])
        && request.resource.data.nhanThongBao is bool
        && get(/databases/$(database)/documents/qa_quan/$(request.resource.data.quanId)).data.chuQuanId != request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    // Chat riêng của Quán ăn: chỉ 2 người trong cuộc (và admin khi xử lý khiếu nại). Gửi tin qua hệ thống.
    match /qa_chat/{chatId} {
      allow read: if signedIn() && (resource == null || request.auth.uid in resource.data.thanhVien || laAdmin('quanAn'));
      allow write: if false;

      match /tin_nhan/{tinId} {
        allow read: if signedIn() && (request.auth.uid in get(/databases/$(database)/documents/qa_chat/$(chatId)).data.thanhVien
          || laAdmin('quanAn'));
        allow write: if false;
      }
    }

    // Đánh giá: hiện công khai (trừ bị ẩn); người viết xem đánh giá của mình. Viết / sửa qua hệ thống.
    match /qa_danh_gia/{id} {
      allow read: if resource == null || resource.data.trangThaiHienThi == 'hien'
        || (signedIn() && resource.data.svId == request.auth.uid) || laAdmin('quanAn');
      allow write: if false;
    }

    match /qa_bao_cao/{id} {
      allow read: if laAdmin('quanAn');
      allow write: if false;
    }

    match /qa_bao_cao_sai/{id} {
      allow read, write: if false;
    }

    match /qa_khang_nghi/{id} {
      allow read: if signedIn() && (resource.data.nguoiGui == request.auth.uid || laAdmin('quanAn'));
      allow write: if false;
    }

    // Thông báo: người nhận đọc và chỉ được đánh dấu đã đọc.
    match /qa_thong_bao/{id} {
      allow read: if signedIn() && resource.data.nguoiNhan == request.auth.uid;
      allow update: if signedIn() && resource.data.nguoiNhan == request.auth.uid
        && chiDoiCacTruong(['docLuc']);
      allow create, delete: if false;
    }

    match /qa_nhat_ky_admin/{id} {
      allow read: if laAdmin('quanAn');
      allow write: if false;
    }

    // Cấu hình: chỉ đọc / ghi qua hệ thống (admin ghi đè bằng hành động adminCauHinh).
    match /qa_cau_hinh/{id} {
      allow read, write: if false;
    }

    // Điểm vui chơi: ai cũng xem được. Đăng mới phải đi kèm lượt đếm trong quota/{uid}
    // (tối đa 10 tin/ngày) giống Shop và Xe dọn trọ. Không ai sửa/xóa qua app.
    match /vui_choi/{id} {
      allow read: if true;
      allow create: if isCountedPost(id, 'ownerId')
        && request.resource.data.keys().hasOnly(['ownerId', 'name', 'images', 'category', 'location',
                                                 'address', 'openHour', 'closeHour', 'ticketPrice',
                                                 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 200
        && request.resource.data.category in ['cafe', 'rap_phim', 'cong_vien']
        && request.resource.data.address is string
        && request.resource.data.address.size() > 0
        && request.resource.data.address.size() <= 300
        && request.resource.data.location is latlng
        && request.resource.data.openHour is string
        && request.resource.data.openHour.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        && request.resource.data.closeHour is string
        && request.resource.data.closeHour.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        && request.resource.data.ticketPrice is number
        && request.resource.data.ticketPrice >= 0
        && isUrlList(request.resource.data.images, 6)
        && request.resource.data.images.size() > 0
        && allHttpsUrls(request.resource.data.images);
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
