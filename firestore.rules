rules_version = '2';

// Chưa có đăng nhập (task 1.3): ai cũng đọc và tạo mới được, không ai sửa/xóa.
// Khi có Firebase Auth, thêm điều kiện request.auth != null và kiểm tra ownerId.
service cloud.firestore {
  match /databases/{database}/documents {
    function isNewDoc(fields) {
      return request.resource.data.keys().hasOnly(fields)
        && request.resource.data.createdAt == request.time;
    }

    function isUrlList(value, max) {
      return value is list && value.size() <= max;
    }

    match /products/{id} {
      allow read: if true;
      allow create: if isNewDoc(['shopId', 'name', 'images', 'price', 'sizes',
                                 'stock', 'category', 'status', 'videos', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 200
        && request.resource.data.price is number
        && request.resource.data.price >= 0
        && request.resource.data.stock is int
        && request.resource.data.status == 'active'
        && isUrlList(request.resource.data.images, 10)
        && request.resource.data.images.size() > 0
        && isUrlList(request.resource.data.videos, 1);
      allow update, delete: if false;
    }

    match /booking_xe/{id} {
      allow read: if true;
      allow create: if isNewDoc(['userId', 'driverId', 'fromAddress', 'toAddress',
                                 'itemPhotos', 'quotedPrice', 'scheduledAt', 'status',
                                 'videos', 'createdAt'])
        && request.resource.data.fromAddress is string
        && request.resource.data.fromAddress.size() > 0
        && request.resource.data.toAddress is string
        && request.resource.data.toAddress.size() > 0
        && request.resource.data.scheduledAt is timestamp
        && request.resource.data.quotedPrice == null
        && request.resource.data.status == 'pending'
        && isUrlList(request.resource.data.itemPhotos, 10)
        && isUrlList(request.resource.data.videos, 1);
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
